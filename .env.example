DB_PASSWORD=change_me_local_only
# 後台帳號的初始密碼（第一次啟動時建立 admin、manager、sales 三個帳號；之後改密碼請用後台帳號管理）
ADMIN_PASSWORD=change_me_123
MANAGER_PASSWORD=change_me_123
SALES_PASSWORD=change_me_123
# 系統整合用的服務權杖（測試程式等使用；同仁請用帳號登入）
STAFF_TOKEN=change_me_local_only
APP_PORT=8100

# AI 客服：金鑰到 console.anthropic.com 申請，只放在這個檔案，不要傳給任何人。
# 留空時 AI 客服會顯示「尚未啟用」，其他功能照常運作。
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
# 每天最多幾次對話、最多花多少美元，超過就暫停到隔天。
DAILY_CHAT_LIMIT=200
DAILY_COST_LIMIT_USD=1.00

# 模擬 ERP：主系統用這把金鑰呼叫 ERP，請改成自己的隨機字串
ERP_API_KEY=change_me_local_only
ERP_PORT=8101

# 採購：主管權杖用來核准大額或超出預算的採購單
MANAGER_TOKEN=change_me_local_only
PROCUREMENT_MODEL=claude-opus-5-5
MANAGER_APPROVAL_THRESHOLD=30000

# 官網串接：模擬官網使用的合作夥伴 API 金鑰（安裝時隨機產生）
PARTNER_DEMO_KEY=pk_change_me_local_only
WEBSITE_PORT=8103

# n8n 自動化：n8n 呼叫主系統用的權杖；編輯畫面 http://localhost:5678
AUTOMATION_TOKEN=change_me_local_only
N8N_PORT=5678

# Email 通知：n8n 寄到模擬信箱 Mailpit，收件畫面 http://localhost:8025（不會真的寄出）
MAIL_UI_PORT=8025
SALES_EMAIL=sales@travel.example
MANAGER_EMAIL=manager@travel.example
IT_EMAIL=it@travel.example

# 監控：Prometheus 抓指標用的權杖、Grafana 管理員密碼（安裝時隨機產生）
METRICS_TOKEN=change_me_local_only
GRAFANA_PASSWORD=change_me_123
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000

# RAG 向量模型：finetuned＝有微調模型就用（預設），base＝固定用原始模型
RAG_MODEL=finetuned
